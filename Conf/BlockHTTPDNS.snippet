# HTTPDNS拦截器
# description:  [oai_citation:1‡GitHub](https://github.com/crossutility/Quantumult-X/blob/master/sample.conf?utm_source=chatgpt.com)够在 Quantumult X 的 DNS / Rewrite 框架下工作。
# author: 可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md], VirgilClyne[https://github.com/VirgilClyne]
# homepage: https://hub.kelee.one
# icon: https://raw.githubusercontent.com/luestr/IconResource/main/Other_icon/120px/HTTPDNS.png
#
# 转换说明：
# Loon domain_keyword -> QX host-keyword
# Loon domain -> QX host
# Loon user_agent -> QX user-agent
# Loon ip_cidr -> QX ip-cidr
# Loon ip_cidr6 -> QX ip6-cidr
# Loon rules.url_regex -> QX rewrite_local: url reject
# Loon url_rewrites location=http://reject-dict/ status_code=200 -> QX url reject-dict
# Loon url_rewrites location=http://reject/ status_code=307 -> QX url reject
# Loon no_resolve -> QX 本地 ip-cidr / ip6-cidr 不写 no-resolve 参数

#[filter_local]
# > domain_keyword -> host-keyword
host-keyword, httpdns, reject
host-keyword, httpsdns, reject

# > user_agent -> user-agent
user-agent, httpdns*, reject
user-agent, httpsdns*, reject
user-agent, Httpdns*, reject
user-agent, Httpsdns*, reject

