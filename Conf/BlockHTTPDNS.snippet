#[rewrite_local]
# > rules.url_regex -> rewrite_local url reject
^http://((25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\.){3}(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)(?:/v?[0-9]+)?/(?:sign_)?(?:(?:d|ss)[46]?|resolve)\? url reject
^http://\[[0-9a-fA-F:]+\](?:/v?[0-9]+)?/(?:sign_)?(?:(?:d|ss)[46]?|resolve)\? url reject
^http://103\.44\.58\.64/md\? url reject
^http://cdn\.wup\.huya\.com/launch/queryHttpDns url reject
^http://xmc\.ximalaya\.com/xmlymain-login-web/login/ url reject
^http://103\.37\.155\.60/fetch url reject
^http://api\.weibo\.cn/\d+/httpdns/config url reject
^http://api\.weibo\.cn/httpdns/config url reject
^http:\/\/((25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\.){3}(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\/v\d\/resolv\? url reject
^http://((25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\.){3}(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?):\d+/httpdns/ url reject
^http://\[[0-9a-fA-F:]+\]:\d+/httpdns/ url reject

# > url_rewrites reject-dict / reject
^https?:\/\/appconf\.mail\.163\.com\/mailmaster\/api\/http\/urlConfig\.do$ url reject-dict
^https?:\/\/cdn\.wup\.huya\.com\/monitor\/monitor\.jsp url reject
^https:\/\/msglb\.91160\.com\/msg\/outer\/broker\/get$ url reject-dict
^https:\/\/gslbali\.ximalaya\.com\/linkeye-cloud\/httpdns\/ url reject
^https:\/\/ucdc\d?-upaas\.uc\.cn\/api\/v\d\/dns_query\? url reject-dict
^https:\/\/gw-cn\.jiaoliuqu\.com\/taqu-im-broadcast-srv\/v\d\/Comet\/get\? url reject-dict

#[mitm]
# > mitm.hostnames.includes -> hostname
hostname = appconf.mail.163.com, msglb.91160.com, ucdc2-upaas.uc.cn, gw-cn.jiaoliuqu.com